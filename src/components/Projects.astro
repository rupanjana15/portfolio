---
import type { CollectionEntry } from "astro:content";
import Cat from "./Cat.astro";
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const categories = Array.from(new Set(projects.map((project) => project.data.category)));
const formatCategory = (category: string) =>
  category
    .split(/[-_\s]+/)
    .filter(Boolean)
    .map((word) => (word.length <= 2 ? word.toUpperCase() : word.charAt(0).toUpperCase() + word.slice(1)))
    .join(" ");
---

<section id="projects" class="section">
  <SectionHeading eyebrow="Selected work" title="Built to solve real problems." />
  <div class="filter-bar" aria-label="Project filters">
    <button class="filter-btn active" type="button" data-filter="all">All work</button>
    {categories.map((category) => (
      <button class="filter-btn" type="button" data-filter={category}>
        {formatCategory(category)}
      </button>
    ))}
    <Cat class="filter-cat" />
  </div>
  <div class="projects-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
  <dialog class="play-dialog" aria-labelledby="play-title">
    <div class="play-bar">
      <strong id="play-title"></strong>
      <a class="play-newtab" href="" target="_blank" rel="noreferrer">Open in a new tab <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
      <button class="play-close" type="button" aria-label="Close game"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <iframe title="Game" allow="fullscreen"></iframe>
  </dialog>
</section>
