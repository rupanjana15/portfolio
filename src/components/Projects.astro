---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const categories = Array.from(new Set(projects.map((project) => project.data.category)));
const formatCategory = (category: string) =>
  category
    .split(/[-_\s]+/)
    .filter(Boolean)
    .map((word) => (word.length <= 2 ? word.toUpperCase() : word.charAt(0).toUpperCase() + word.slice(1)))
    .join(" ");
---

<section id="projects" class="section">
  <SectionHeading eyebrow="Selected work" title="Built to solve real problems." />
  <div class="filter-bar" aria-label="Project filters">
    <button class="filter-btn active" type="button" data-filter="all">All work</button>
    {categories.map((category) => (
      <button class="filter-btn" type="button" data-filter={category}>
        {formatCategory(category)}
      </button>
    ))}
    <span class="filter-cat" aria-hidden="true">
      <span class="filter-cat-hop">
        <svg viewBox="0 0 40 36" width="40" height="36">
          <path class="filter-cat-tail" d="M9 30 C 1 30, 0 18, 6 15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <ellipse cx="18" cy="26" rx="11" ry="9" fill="currentColor" />
          <circle cx="28" cy="14" r="7.5" fill="currentColor" />
          <polygon points="21.5,10 22.5,1.5 27,7" fill="currentColor" />
          <polygon points="29,7 33.5,1.5 34.5,10" fill="currentColor" />
          <g class="filter-cat-eyes" fill="var(--bg)">
            <circle cx="25.5" cy="14" r="1.3" />
            <circle cx="31" cy="14" r="1.3" />
          </g>
        </svg>
      </span>
    </span>
  </div>
  <div class="projects-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
