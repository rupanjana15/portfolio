---
interface Props {
  class?: string;
  sleepy?: boolean;
}

const { class: className, sleepy = false } = Astro.props;
---

<span class:list={["cat", className, { sleeping: sleepy }]} data-sleepy={sleepy ? "true" : undefined} aria-hidden="true">
  <span class="cat-body">
    <svg class="cat-sit" viewBox="0 0 40 36" width="40" height="36">
      <path class="cat-tail" d="M9 30 C 1 30, 0 18, 6 15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      <ellipse cx="18" cy="26" rx="11" ry="9" fill="currentColor" />
      <circle cx="28" cy="14" r="7.5" fill="currentColor" />
      <polygon points="21.5,10 22.5,1.5 27,7" fill="currentColor" />
      <polygon points="29,7 33.5,1.5 34.5,10" fill="currentColor" />
      <g class="cat-eyes" fill="var(--bg)">
        <circle cx="25.5" cy="14" r="1.3" />
        <circle cx="31" cy="14" r="1.3" />
      </g>
    </svg>
    <svg class="cat-run" viewBox="0 0 48 36" width="48" height="36">
      <g stroke="currentColor" stroke-width="3.5" stroke-linecap="round">
        <line class="cat-leg cat-leg-back-a" x1="14" y1="22" x2="14" y2="33" />
        <line class="cat-leg cat-leg-back-b" x1="17" y1="22" x2="17" y2="33" />
        <line class="cat-leg cat-leg-front-a" x1="29" y1="22" x2="29" y2="33" />
        <line class="cat-leg cat-leg-front-b" x1="32" y1="22" x2="32" y2="33" />
      </g>
      <path d="M10 19 C 3 17, 2 9, 6 5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      <ellipse cx="22" cy="20" rx="13" ry="7" fill="currentColor" />
      <circle cx="37" cy="14" r="7" fill="currentColor" />
      <polygon points="31,10 32,2 36,7" fill="currentColor" />
      <polygon points="38,7 42,2 43,10" fill="currentColor" />
      <circle cx="40" cy="13.5" r="1.3" fill="var(--bg)" />
    </svg>
    {sleepy && (
      <svg class="cat-sleep" viewBox="0 0 48 36" width="48" height="36">
        <ellipse class="cat-breath" cx="22" cy="27" rx="17" ry="8.5" fill="currentColor" />
        <circle cx="35" cy="24" r="7" fill="currentColor" />
        <polygon points="30,20 31,12.5 35,18" fill="currentColor" />
        <polygon points="36,18 40.5,12.5 41.5,21" fill="currentColor" />
        <path d="M6 30 C 4 36, 24 37, 32 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <g fill="none" stroke="var(--bg)" stroke-width="1.2" stroke-linecap="round">
          <path d="M31 24.5 q1.5 1.2 3 0" />
          <path d="M36.5 24.5 q1.5 1.2 3 0" />
        </g>
      </svg>
    )}
    {sleepy && <span class="cat-zzz"><i>z</i><i>z</i><i>z</i></span>}
  </span>
  <span class="cat-say"></span>
</span>
